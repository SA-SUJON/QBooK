<?xml version="1.0" encoding="utf-8"?>
<!--
  Toolbar action for the Developer options sub-screen.

  A SwitchCompat inside an action item - Android renders it as a
  toggle on the right side of the toolbar (right next to the title
  "Developer Options"). Tapping it flips the developerEnabled
  preference, which hides the Developer options entry back in About
  the next time the user navigates there.

  showAsAction="always" + the switch's namespace="app" means the
  menu inflater treats it as a custom action view, not a normal
  text/icon item. The screen title (Developer Options) and the
  switch both sit on the same bar.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_developer_toggle"
        android:title="@string/pref_developer_enabled"
        app:showAsAction="always"
        app:actionLayout="@layout/action_developer_toggle" />
</menu>

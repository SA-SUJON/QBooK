<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="?attr/qbookSettingsGlassSurfacePressed" />
            <stroke android:width="1dp" android:color="?attr/qbookSettingsGlassHighlight" />
            <padding android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="?attr/qbookSettingsGlassShadow" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="?attr/qbookSettingsCardSurface" />
                    <stroke android:width="1dp" android:color="?attr/qbookSettingsGlassStroke" />
                    <padding android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="?attr/qbookSettingsGlassShadow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="135"
                android:startColor="?attr/qbookSettingsGlassHighlight"
                android:centerColor="?attr/qbookSettingsGlassSurface"
                android:endColor="?attr/qbookSettingsIconContainer" />
            <stroke android:width="1dp" android:color="?attr/qbookSettingsGlassStroke" />
        </shape>
    </item>
</layer-list>

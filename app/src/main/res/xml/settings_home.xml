    <PreferenceCategory android:title="@string/grp_feed_top" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat android:key="hide_stories"
            android:title="@string/pref_hide_stories" android:summary="@string/pref_hide_stories_sum"
            android:defaultValue="false" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat android:key="hide_reels"
            android:title="@string/pref_hide_reels" android:summary="@string/pref_hide_reels_sum"

<?xml version="1.0" encoding="utf-8"?>
<!--
  Developer Options - reached from Hidden Settings -> About by tapping
  the About-this-app entry seven times. The very first switch here is
  the page-top "Developer options enabled" gate: turning it off hides
  the Developer options entry back in About, without re-locking the
  seven-tap gesture (the gesture is one-way, the switch is two-way).
  Below it: the Enable logcat switch and the View / Share / Clear
  buttons for the file the logcat switch produces.

  All the previous diagnostic tools (inspect_ads, log_video_urls,
  dump_dom, sync_diagnostics) are gone. Round 28 reduced the surface
  to switches and file-handling buttons.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:key="developer_enabled"
        android:title="@string/pref_developer_enabled"
        android:summary="@string/pref_developer_enabled_sum"
        android:defaultValue="false"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:key="diagnostic_log"
        android:title="@string/pref_logcat_toggle"
        android:summary="@string/pref_logcat_toggle_sum"
        android:defaultValue="false"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="view_diagnostic_log"
        android:title="@string/pref_diagnostic_view"
        android:summary="@string/pref_diagnostic_view_sum"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="share_diagnostic_log"
        android:title="@string/pref_diagnostic_share"
        android:summary="@string/pref_diagnostic_share_sum"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="clear_diagnostic_log"
        android:title="@string/pref_diagnostic_clear"
        android:summary="@string/pref_diagnostic_clear_sum"
        app:iconSpaceReserved="false" />

</PreferenceScreen>

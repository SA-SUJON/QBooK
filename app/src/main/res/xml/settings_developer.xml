<?xml version="1.0" encoding="utf-8"?>
<!--
  Developer Options - reached from Hidden Settings -> About by tapping
  the About-this-app entry seven times. The "Developer options enabled"
  switch lives in the toolbar at the top of this screen (set up in
  SettingsActivity.onCreate) - it is the master switch, and turning it
  off hides the entry back in About. Below the toolbar:
  Enable logcat switch, then View / Share / Clear buttons for the file
  the logcat switch produces.

  All the previous diagnostic tools (inspect_ads, log_video_urls,
  dump_dom, sync_diagnostics) are gone. Round 28 reduced the surface
  to switches and file-handling buttons.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:key="diagnostic_log"
        android:title="@string/pref_logcat_toggle"
        android:summary="@string/pref_logcat_toggle_sum"
        android:defaultValue="false"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="view_diagnostic_log"
        android:title="@string/pref_diagnostic_view"
        android:summary="@string/pref_diagnostic_view_sum"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="share_diagnostic_log"
        android:title="@string/pref_diagnostic_share"
        android:summary="@string/pref_diagnostic_share_sum"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="clear_diagnostic_log"
        android:title="@string/pref_diagnostic_clear"
        android:summary="@string/pref_diagnostic_clear_sum"
        app:iconSpaceReserved="false" />

</PreferenceScreen>

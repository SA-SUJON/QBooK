<?xml version="1.0" encoding="utf-8"?>
<!--
  Developer Options - reached from Hidden Settings -> About by tapping
  the About-this-app entry seven times. Only one toggle lives here:
  Enable logcat, default off. The full-screen feature is intentionally
  not surfaced in the settings UI; the seven-tap gate is the only path.

  All the previous diagnostic tools (inspect_ads, log_video_urls,
  dump_dom, sync_diagnostics, the diagnostic-log buttons) are gone.
  Round 28 reduced the surface to a single on/off switch.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:key="diagnostic_log"
        android:title="@string/pref_logcat_toggle"
        android:summary="@string/pref_logcat_toggle_sum"
        android:defaultValue="false"
        app:iconSpaceReserved="false" />

</PreferenceScreen>

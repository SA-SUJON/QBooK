<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately short. This screen had grown to nine entries, several of them
  reporting the same thing in different words. What is left is the three
  things to keep, how many reels to keep, what is downloaded, and a way to
  clear it.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/grp_offline"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat android:key="offline_reels"
            android:title="@string/pref_offline_reels"
            android:summary="@string/pref_offline_reels_sum"
            android:defaultValue="true" app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat android:key="offline_feed"
            android:title="@string/pref_offline_feed"
            android:summary="@string/pref_offline_feed_sum"
            android:defaultValue="true" app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat android:key="offline_stories"
            android:title="@string/pref_offline_stories"
            android:summary="@string/pref_offline_stories_sum"
            android:defaultValue="true" app:iconSpaceReserved="false" />

        <!-- Only meaningful when reels are being kept, so it follows the
             switch above rather than standing on its own. -->
        <ListPreference android:key="offline_reel_count"
            android:title="@string/pref_offline_reel_count"
            android:dialogTitle="@string/pref_offline_reel_count_dialog"
            android:entries="@array/reel_count_labels"
            android:entryValues="@array/reel_count_values"
            android:defaultValue="30"
            android:summary="%s"
            android:dependency="offline_reels"
            app:iconSpaceReserved="false" />

        <!-- Same control for the home feed: how many posts are kept,
             after which every capture path stops adding. -->
        <ListPreference android:key="offline_post_count"
            android:title="@string/pref_offline_post_count"
            android:dialogTitle="@string/pref_offline_post_count_dialog"
            android:entries="@array/post_count_labels"
            android:entryValues="@array/post_count_values"
            android:defaultValue="50"
            android:summary="%s"
            android:dependency="offline_feed"
            app:iconSpaceReserved="false" />

        <!-- Which connections may be used. Defaults to Wi-Fi only: a full
             pass is hundreds of megabytes and should not quietly consume a
             mobile allowance. -->
        <ListPreference android:key="offline_network"
            android:title="@string/pref_offline_network"
            android:dialogTitle="@string/offline_network_dialog_title"
            android:entries="@array/offline_network_labels"
            android:entryValues="@array/offline_network_values"
            android:defaultValue="wifi"
            android:summary="%s"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/grp_storage"
        app:iconSpaceReserved="false">

        <Preference android:key="offline_status"
            android:title="@string/pref_offline_status"
            android:selectable="false" app:iconSpaceReserved="false" />

        <Preference android:key="clear_offline"
            android:title="@string/pref_clear_offline"
            android:summary="@string/pref_clear_offline_sum"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>
</PreferenceScreen>

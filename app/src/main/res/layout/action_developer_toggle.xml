<?xml version="1.0" encoding="utf-8"?>
<!--
  Action view for the developer-enabled toggle in the Developer
  Options toolbar. A single SwitchCompat - no title, no summary;
  the screen title "Developer Options" sits to the left of it on
  the toolbar.
-->
<androidx.appcompat.widget.SwitchCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/developer_toggle_switch"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical|end" />

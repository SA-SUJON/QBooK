<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/architect_dialog_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_architect_dialog"
            android:clipToOutline="true"
            android:elevation="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/architect_dev_icon"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/architect_dev_icon_description"
                android:elevation="4dp"
                android:padding="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/architect_profile_picture" />

            <TextView
                android:id="@+id/architect_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/dev_display_name"
                android:textColor="@color/architect_text"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/architect_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="@string/dev_title"
                android:textColor="@color/architect_accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/architect_acknowledge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_architect_action"
                android:clickable="true"
                android:elevation="5dp"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/architect_acknowledge"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/architect_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/architect_projects_label"
                        android:textColor="@color/architect_muted"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/architect_projects_value"
                        android:textColor="@color/architect_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/architect_experience_label"
                        android:textColor="@color/architect_muted"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/architect_experience_value"
                        android:textColor="@color/architect_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/architect_rating_label"
                        android:textColor="@color/architect_muted"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/architect_rating_value"
                        android:textColor="@color/architect_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_architect_overview"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/architect_overview_title"
                    android:textColor="@color/architect_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/dev_bio"
                    android:textColor="@color/architect_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_architect_links"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageButton
                    android:id="@+id/architect_email"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_architect_icon_button"
                    android:contentDescription="@string/architect_email_description"
                    android:padding="13dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_architect_email"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/architect_github"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_architect_icon_button"
                    android:contentDescription="@string/architect_github_description"
                    android:padding="13dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_architect_github"
                    android:tint="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

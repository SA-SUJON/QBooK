<?xml version="1.0" encoding="utf-8"?>
<!--
  Read-only viewer for the in-app diagnostic log. Reachable from
  Settings -> Developer options -> View log. The TextView is a single
  monospace block; the system scrollbar is enabled for long files.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <TextView
        android:id="@+id/diagnostic_log_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textIsSelectable="true"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:scrollbars="vertical"
        android:gravity="top|start" />

</ScrollView>

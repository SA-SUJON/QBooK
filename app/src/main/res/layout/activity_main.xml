<?xml version="1.0" encoding="utf-8"?>
<!--
  No app-drawn navigation. Facebook's own header and tab bar are rendered by
  the site itself, so every control the user sees is a real Facebook control.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_bg"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- V4 Step 4: Slightly thicker progress bar for better visibility -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/fb_brand"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.qbook.ui.MediaWebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- Offline / error state -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fb_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0.5"
            android:contentDescription="@string/offline_title"
            android:src="@drawable/ic_offline"
            app:tint="@color/fb_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/offline_title"
            android:textColor="@color/fb_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/offline_message"
            android:textColor="@color/fb_text_dim"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/errorRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/retry"
            app:backgroundTint="@color/fb_brand" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/errorOffline"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/view_offline"
            android:textColor="@color/fb_brand" />
    </LinearLayout>


    <TextView
        android:id="@+id/downloadIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_qbook_pill"
        android:elevation="8dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="@color/fb_text"
        android:textSize="12sp"
        android:visibility="gone" />



    <LinearLayout
        android:id="@+id/unifiedActionMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:gravity="end"
        android:orientation="vertical"
        android:elevation="10dp"
        android:translationZ="10dp">

        <LinearLayout
            android:id="@+id/unifiedActionPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/actionSettings"
                style="@style/UnifiedGlassAction"
                android:text="@string/action_menu_settings" />

            <TextView
                android:id="@+id/actionBookmark"
                style="@style/UnifiedGlassAction"
                android:text="@string/action_menu_bookmark" />

            <TextView
                android:id="@+id/actionDownloadCenter"
                style="@style/UnifiedGlassAction"
                android:text="@string/action_menu_download_center" />

            <TextView
                android:id="@+id/actionReaderMode"
                style="@style/UnifiedGlassAction"
                android:text="@string/action_menu_reader_mode" />

            <TextView
                android:id="@+id/actionScreenshot"
                style="@style/UnifiedGlassAction"
                android:text="@string/action_menu_screenshot" />

            <TextView
                android:id="@+id/actionCopyLink"
                style="@style/UnifiedGlassAction"
                android:text="@string/action_menu_copy_link" />

            <TextView
                android:id="@+id/actionSaveAll"
                style="@style/UnifiedGlassAction"
                android:text="@string/action_menu_save_all" />

            <TextView
                android:id="@+id/actionSaveMedia"
                style="@style/UnifiedGlassAction"
                android:text="@string/action_menu_save_media" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/unifiedActionToggle"
            style="@style/UnifiedGlassToggle"
            android:contentDescription="@string/action_menu_open"
            android:src="@drawable/ic_expand_up" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

</FrameLayout>

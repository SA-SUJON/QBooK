<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accounts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/qbookSettingsBackground">

    <ScrollView
        android:id="@+id/accounts_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="0dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/accounts_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_settings_glass_circle"
                    android:contentDescription="@string/accounts_close"
                    android:padding="12dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/settings_icon_foreground" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_accounts_glass"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/accounts_sessions"
                        android:textColor="@color/settings_title_foreground"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/accounts_sessions_subtitle"
                        android:textColor="@color/settings_body_foreground"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accounts_add_profile"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/accounts_add_profile"
                    android:textColor="@color/settings_title_foreground"
                    app:strokeColor="?attr/qbookSettingsGlassStroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accounts_import_cookies"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/accounts_import_cookies"
                    android:textColor="@color/settings_title_foreground"
                    app:strokeColor="?attr/qbookSettingsGlassStroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accounts_backup"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/accounts_backup_sessions"
                    android:textColor="@color/settings_body_foreground"
                    app:strokeColor="?attr/qbookSettingsGlassStroke"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accounts_restore"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/accounts_restore_backup"
                    android:textColor="@color/settings_body_foreground"
                    app:strokeColor="?attr/qbookSettingsGlassStroke"
                    app:strokeWidth="1dp" />
            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="32dp"
                android:letterSpacing="0.18"
                android:text="@string/accounts_profiles"
                android:textAllCaps="true"
                android:textColor="@color/settings_body_foreground"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/accounts_profile_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/accounts_incognito_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_accounts_glass_accent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/accounts_incognito"
                        android:textColor="@color/settings_title_foreground"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/accounts_incognito_sum"
                        android:textColor="@color/settings_body_foreground"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accounts_incognito_open"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="@string/accounts_open"
                    android:textColor="@color/settings_title_foreground"
                    app:strokeColor="?attr/qbookSettingsGlassStroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/labs_disclaimer_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_labs_disclaimer"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_settings_glass_circle"
            android:contentDescription="@string/labs_disclaimer_icon_desc"
            android:padding="9dp"
            android:src="@drawable/ic_settings_labs"
            android:tint="@color/settings_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/labs_disclaimer_title"
            android:textColor="@color/settings_title_foreground"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/labs_disclaimer_lead"
        android:textColor="@color/settings_title_foreground"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:text="@string/labs_disclaimer_paragraph_one"
                android:textColor="@color/settings_body_foreground"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                    android:text="@string/labs_disclaimer_paragraph_two"
                android:textColor="@color/settings_body_foreground"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                    android:text="@string/labs_disclaimer_paragraph_three"
                android:textColor="@color/settings_body_foreground"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/labs_disclaimer_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:indicatorColor="@color/settings_accent"
        app:trackColor="@color/settings_divider"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <TextView
        android:id="@+id/labs_disclaimer_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/labs_disclaimer_waiting"
        android:textColor="@color/settings_body_foreground"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/labs_disclaimer_abort"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/labs_disclaimer_abort"
            android:textColor="@color/settings_body_foreground"
            app:rippleColor="@color/settings_glass_surface_pressed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/labs_disclaimer_accept"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:enabled="false"
            android:text="@string/labs_disclaimer_accept"
            android:textColor="@color/labs_accept_button_text"
            app:backgroundTint="@color/labs_accept_button_tint"
            app:rippleColor="@color/settings_glass_surface_pressed" />
    </LinearLayout>
</LinearLayout>

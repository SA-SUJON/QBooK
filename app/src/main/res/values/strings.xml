    <!--
      Diagnostic log subsystem - one toggle per topic the
      developer wants to investigate. Each toggle is a
      [Diag.Channel] in the store, and each writes a per-
      channel file under cacheDir/diagnostic that the viewer
      (DiagnosticLogActivity) reads back. The viewer has
      a clear / clear-all / export-as-json / export-as-text
      row at the bottom. The toggle summaries note the
      online/offline split: home feed captures fire on the
      home feed whether online or offline; ads captures
      fire on the sponsored-content strip; network captures
      fire on every blocked / allowed request; offline
      save captures fire on the BackgroundSyncManager
      cycle; lifecycle captures fire on every onCreate /
      onResume / onPause / onDestroy of the main activity.
    -->
    <string name="diag_all">Capture all app events</string>
    <string name="diag_all_sum">Master capture: records every available diagnostic channel, including errors and lifecycle events. Enable this before reproducing any unknown bug.</string>
    <string name="diag_mark">Mark reproduction moment</string>
    <string name="diag_mark_sum">Writes an exact timestamp marker to the log so the bug window can be located.</string>
    <string name="diag_ch_home_feed">Home feed log</string>
    <string name="diag_ch_home_feed_sum">Every page load, scroll position, video state, and right-swipe gesture on the home feed. Online and offline. Off by default.</string>
    <string name="diag_ch_reels">Reels tab log</string>
    <string name="diag_ch_reels_sum">Every scroll, every video tap, every peek UI expand on the Reels tab. Off by default.</string>
    <string name="diag_ch_story">Story tab log</string>
    <string name="diag_ch_story_sum">Story tray scroll, story load, story tap. Off by default.</string>
    <string name="diag_ch_ads">Ads log</string>
    <string name="diag_ch_ads_sum">Every sponsored-content match and removal, with the selector and the reason. Off by default.</string>
    <string name="diag_ch_network">Network log</string>
    <string name="diag_ch_network_sum">Every blocked or allowed network request, with host, path, and decision. The throttle on adblock.intercept mainFrame stays at the 1 entry/sec limit; this is a separate throttle. Off by default.</string>
    <string name="diag_ch_offline_save">Offline save log</string>
    <string name="diag_ch_offline_save_sum">Every BackgroundSyncManager cycle, every SectionVault fetch, every vault hit / miss. Online and offline. Off by default.</string>
    <string name="diag_ch_lifecycle">App lifecycle log</string>
    <string name="diag_ch_lifecycle_sum">Every onCreate, onResume, onPause, onDestroy of MainActivity, with saved-instance flag. Off by default.</string>


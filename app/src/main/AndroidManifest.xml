            android:icon="@mipmap/ic_launcher_alt15"
            android:roundIcon="@mipmap/ic_launcher_alt15"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified">

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="facebook.com" />
                <data android:scheme="https" android:host="www.facebook.com" />
                <data android:scheme="https" android:host="m.facebook.com" />
                <data android:scheme="https" android:host="fb.watch" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- No launcher entry; opened from the visible QBooK Control Center
             button inside MainActivity. -->
        <activity
            android:name=".ui.AccountsActivity"
            android:exported="false"
            android:label="@string/accounts_sessions"
            android:excludeFromRecents="true"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.QBooK" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/hidden_settings"
            android:excludeFromRecents="true"
            android:parentActivityName=".ui.MainActivity"
            android:theme="@style/Theme.QBooK" />

        <activity
            android:name=".ui.MediaGalleryActivity"
            android:exported="false"
            android:label="@string/labs_gallery_title"
            android:excludeFromRecents="true"
            android:parentActivityName=".ui.SettingsActivity"
            android:theme="@style/Theme.QBooK" />
        <activity
            android:name=".ui.DownloadCenterActivity"
            android:exported="false"
            android:label="@string/labs_download_center"
            android:excludeFromRecents="true"
            android:parentActivityName=".ui.SettingsActivity"
            android:theme="@style/Theme.QBooK" />

        <activity
            android:name=".ui.DiagnosticLogActivity"
            android:exported="false"
            android:label="@string/diagnostic_log_title"
            android:excludeFromRecents="true"
            android:parentActivityName=".ui.SettingsActivity"
            android:theme="@style/Theme.QBooK" />

        <service
            android:name=".ui.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <service
            android:name=".ui.SyncService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
